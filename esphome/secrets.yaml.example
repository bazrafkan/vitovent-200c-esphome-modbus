# Copy to secrets.yaml (ESPHome Device Builder: "Secrets" button) and fill in.
# Never commit the real secrets.yaml.
wifi_ssid: "your-2.4GHz-ssid"
wifi_password: "your-wifi-password"
vmc_api_key: "generate-with: openssl rand -base64 32"
vmc_ota_password: "choose-a-password"
vmc_ap_password: "choose-a-password"
